# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text and jsonl files
*.md text
*.txt text
*.csv text
*.json text
*.jsonl text
*.py text
*.cff text
*.schema.json text

# Binary file declarations
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.parquet binary
*.gz binary
